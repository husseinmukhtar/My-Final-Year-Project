<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adoptions — Print</title>
    <style>
        body { font-family: Inter, Segoe UI, sans-serif; background: #f5f5f5; color: #111; margin: 0; padding: 24px; }
        h1 { font-size: 22px; margin: 0 0 8px; }
        .meta { color: #666; font-size: 13px; margin-bottom: 24px; }
        table { width: 100%; border-collapse: collapse; background: #fff; box-shadow: 0 1px 3px rgba(0,0,0,.08); }
        th, td { border: 1px solid #ddd; padding: 8px 10px; text-align: left; font-size: 12px; }
        th { background: #fafafa; font-weight: 600; }
        tr:nth-child(even) td { background: #fcfcfc; }
        .toolbar { margin-bottom: 16px; }
        button { padding: 10px 18px; background: #4F46E5; color: #fff; border: none; border-radius: 8px; cursor: pointer; font-weight: 600; }
        @media print {
            .toolbar { display: none; }
            body { background: #fff; padding: 0; }
        }
    </style>
</head>
<body>
    <div class="toolbar">
        <button type="button" onclick="window.print()">Print or Save as PDF</button>
    </div>
    <h1>Adoption records</h1>
    <div class="meta">Generated: <%= printedAt ? printedAt.toISOString().slice(0,19).replace('T',' ') : '' %> · <%= (rows && rows.length) || 0 %> row(s)</div>
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Child</th>
                <th>Adopter</th>
                <th>Status</th>
                <th>Application</th>
                <th>Scheduled visit</th>
                <th>Email</th>
                <th>Phone</th>
            </tr>
        </thead>
        <tbody>
            <% if (rows && rows.length) { rows.forEach(function (r) { %>
            <tr>
                <td><%= r.id %></td>
                <td><%= r.child_name %> (<%= r.child_id %>)</td>
                <td><%= r.adopter_full_name %></td>
                <td><%= r.adoption_status %></td>
                <td><%= r.application_date ? String(r.application_date).slice(0,10) : '' %></td>
                <td><%= r.visit_scheduled_at ? String(r.visit_scheduled_at).replace('T', ' ').slice(0,16) : '' %></td>
                <td><%= r.adopter_email %></td>
                <td><%= r.adopter_phone %></td>
            </tr>
            <% }); } else { %>
            <tr><td colspan="8">No records.</td></tr>
            <% } %>
        </tbody>
    </table>
</body>
</html>
