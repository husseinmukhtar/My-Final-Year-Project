<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>403 Forbidden</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #0f172a;
            color: #f8fafc;
            display: flex;
            align-items: center;
            justify-content: center;
            height: 100vh;
            margin: 0;
            font-family: 'Inter', -apple-system, sans-serif;
        }
        .error-container {
            text-align: center;
            background: rgba(15, 23, 42, 0.75);
            padding: 40px;
            border-radius: 12px;
            border: 1px solid rgba(239, 68, 68, 0.3);
            box-shadow: 0 10px 25px rgba(0,0,0,0.5);
            max-width: 500px;
            width: 100%;
        }
        h1 {
            font-size: 80px;
            margin-bottom: 10px;
            color: #ef4444;
            font-weight: 700;
        }
        h2 {
            font-size: 24px;
            margin-bottom: 20px;
        }
        p {
            color: #94a3b8;
            margin-bottom: 30px;
        }
    </style>
</head>
<body>
    <div class="error-container">
        <h1>403</h1>
        <h2>Access Denied</h2>
        <p>You do not have permission to view this page or perform this action. This area is restricted to Administrators only.</p>
        <a href="/children/dashboard" class="btn btn-primary">Return to Dashboard</a>
    </div>
</body>
</html>
