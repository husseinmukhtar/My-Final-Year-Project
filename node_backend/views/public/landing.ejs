<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Orphanage Management System</title>
  <!-- Font Awesome for Icons -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css" />
  <!-- SweetAlert2 -->
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <!-- Paystack Inline JS -->
  <script src="https://js.paystack.co/v1/inline.js"></script>
  <style>
    /* Modal layout styles on top of style.css */
    .modal-overlay {
        position: fixed;
        top: 0; left: 0; right: 0; bottom: 0;
        background: rgba(0, 0, 0, 0.7);
        backdrop-filter: blur(5px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 2000;
        opacity: 0;
        pointer-events: none;
        transition: opacity 0.3s ease;
    }

    .modal-overlay.active {
        opacity: 1;
        pointer-events: all;
    }

    .modal-content {
        background: rgba(15, 23, 42, 0.85); /* Deep slate with transparency */
        backdrop-filter: blur(25px);
        -webkit-backdrop-filter: blur(25px);
        border: 1px solid rgba(99, 102, 241, 0.3);
        border-radius: var(--radius-lg);
        padding: 2.5rem;
        box-shadow: 0 0 40px rgba(99, 102, 241, 0.2), 0 25px 50px -12px rgba(0, 0, 0, 0.8);
        width: 100%;
        max-width: 600px;
        max-height: 90vh;
        overflow-y: auto;
        transform: translateY(20px) scale(0.95);
        transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        position: relative;
    }

    .modal-overlay.active .modal-content {
        transform: translateY(0) scale(1);
    }

    .modal-close {
        position: absolute;
        top: 1.5rem;
        right: 1.5rem;
        background: none;
        border: none;
        color: var(--text-muted);
        font-size: 1.5rem;
        cursor: pointer;
        transition: color 0.3s;
    }

    .modal-close:hover {
        color: white;
    }

    .type-toggle {
        display: flex;
        gap: 0.5rem;
        margin-bottom: 1.5rem;
        background: rgba(0,0,0,0.2);
        padding: 0.375rem;
        border-radius: 9999px;
        border: 1px solid var(--glassborder);
    }

    .type-toggle label {
        flex: 1;
        margin: 0;
        text-align: center;
        padding: 0.625rem;
        border-radius: 9999px;
        cursor: pointer;
        transition: all 0.3s ease;
        color: var(--text-muted);
        font-size: 14px;
        font-weight: 500;
    }
    
    .type-toggle input[type="radio"] {
        display: none;
    }

    .type-toggle input[type="radio"]:checked + label {
        background: var(--primary);
        color: white;
        font-weight: 600;
        box-shadow: 0 4px 6px -1px rgba(0,0,0,0.2);
    }

    .form-row {
        display: flex;
        gap: 1rem;
    }

    .form-row .form-group {
        flex: 1;
    }
  </style>
</head>
<body>

  <!-- Background Decorators -->
  <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-primary rounded-full mix-blend-screen filter blur-[128px] opacity-30 animate-pulse-slow"></div>
  <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-secondary rounded-full mix-blend-screen filter blur-[128px] opacity-20"></div>
  
  <header>
    <nav class="navbar">
      <h1 class="logo"><i class="fa-solid fa-hands-holding-child text-primary mr-2"></i> OMS<span class="text-primary text-xs ml-1 font-mono">SYSTEM</span></h1>
      <ul class="nav-links">
        <li class="desktop-only"><a href="/">Home</a></li>
        <li class="desktop-only"><a href="#about">About</a></li>
        <li class="desktop-only"><a href="#contact">Contact</a></li>
        <li><a href="#" onclick="openDonationModal(); return false;" class="btn btn-donate shimmer-btn">Donate <i class="fa-solid fa-heart ml-1"></i></a></li>
        <li><a href="/public/child-report" class="btn btn-outline btn-small">Report / Register a Child</a></li>
        <li><a href="/apply-adoption" class="btn btn-outline btn-small">Apply for Adoption</a></li>
        <li><a href="/login" class="btn btn-outline btn-small">Login</a></li>
      </ul>
    </nav>
  </header>

  <main class="flex-grow flex flex-col items-center justify-center relative z-10">
    <section class="hero exciting-hero">
      <div class="hero-content">
        <div class="hero-left text-center">
          <p class="hero-tag">Care • Support • Hope</p>
          <h2>Building a Better Future for Every Child</h2>
          <p class="hero-desc">
            A smart orphanage management system for managing children records,
            staff, donations, and adoption requests in one secure place.
          </p>

          <div class="hero-buttons">
            <a href="/apply-adoption" class="btn btn-primary shimmer-btn">Apply for Adoption</a>
            <a href="/public/child-report" class="btn btn-primary shimmer-btn">Report / Register a Child</a>
            <a href="#" onclick="openDonationModal(); return false;" class="btn btn-donate shimmer-btn">Donate Now <i class="fa-solid fa-heart ml-1"></i></a>
            <a href="/login" class="btn btn-outline" style="background: rgba(0,0,0,0.3); border-color: var(--glassborder); color: #fff;">Login</a>
          </div>

          <div class="quick-stats">
            <div class="mini-stat">
              <h3>120+</h3>
              <p>Children</p>
            </div>
            <div class="mini-stat">
              <h3>35+</h3>
              <p>Staff</p>
            </div>
            <div class="mini-stat">
              <h3>200+</h3>
              <p>Donors</p>
            </div>
          </div>
        </div>
        <div class="hero-right">
          <img src="/images/children.jpg" alt="Hope and Future Illustration" class="hero-illustration">
        </div>
      </div>
    </section>

    <section class="welcome-section" id="about">
      <div class="welcome-text">
        <h2>Welcome to OMS</h2>
        <p>
          The Orphanage Management System is designed to improve the way orphanages
          organize daily activities and store important information. It reduces paperwork,
          improves efficiency, and supports better care for children.
        </p>
      </div>
    </section>

    <section class="features">
      <h2>Core Features</h2>
      <div class="feature-box">
        <div class="card">
          <div class="icon"><i class="fa-solid fa-child"></i></div>
          <h3>Child Records</h3>
          <p>Store health, education, and personal details safely and clearly.</p>
        </div>
        <div class="card hover-card icon-card">
          <div class="icon"><i class="fa-solid fa-chalkboard-user"></i></div>
          <h3>Staff Management</h3>
          <p>Manage staff profiles, roles, and responsibilities with ease.</p>
        </div>
        <div class="card hover-card icon-card">
          <div class="icon"><i class="fa-solid fa-hand-holding-heart"></i></div>
          <h3>Donations</h3>
          <p>Track cash and item donations from donors in an organized way.</p>
        </div>
        <div class="card hover-card icon-card">
          <div class="icon"><i class="fa-solid fa-file-signature"></i></div>
          <h3>Adoption Requests</h3>
          <p>Receive, review, and manage adoption applications professionally.</p>
        </div>
      </div>
    </section>

    <section class="image-banner">
      <div class="overlay">
        <h2>Every Child Deserves Love, Safety, and Opportunity</h2>
        <p>Technology can help care teams focus more on people and less on paperwork.</p>
      </div>
    </section>

    <section class="testimonial-section">
      <h2>Why This Project Is Valuable</h2>
      <div class="feature-box">
        <div class="card testimonial-card">
          <p>"A digital system improves record keeping and makes management faster."</p>
          <h4 style="margin-top: 15px; color: var(--primary);">Project Benefit</h4>
        </div>
        <div class="card testimonial-card">
          <p>"Donation tracking becomes more transparent and easier to manage."</p>
          <h4 style="margin-top: 15px; color: var(--primary);">System Strength</h4>
        </div>
        <div class="card testimonial-card">
          <p>"The dashboard gives a clear overview of daily orphanage operations."</p>
          <h4 style="margin-top: 15px; color: var(--primary);">Admin Advantage</h4>
        </div>
      </div>
    </section>

    <footer class="main-footer" id="contact">
      <div class="footer-content" style="max-width: 1200px; margin: 0 auto;">
        <div class="footer-box">
          <h3>OMS</h3>
          <p style="color: var(--text-muted); font-size: 14px;">A web-based orphanage management system for better care and organization.</p>
        </div>
        <div class="footer-box">
          <h3 style="margin-bottom: 10px;">Contact</h3>
          <p style="color: var(--text-muted); font-size: 14px;"><i class="fa-solid fa-envelope mr-2"></i> info@oms.com</p>
          <p style="color: var(--text-muted); font-size: 14px;"><i class="fa-solid fa-phone mr-2"></i> +234 000 000 0000</p>
          <p style="color: var(--text-muted); font-size: 14px;"><i class="fa-solid fa-location-dot mr-2"></i> Your City</p>
        </div>
      </div>
      <p class="footer-bottom" style="text-align: center; color: var(--text-muted); margin-top: 30px; font-size: 13px;">&copy; 2026 Orphanage Management System. All rights reserved.</p>
    </footer>
  </main>

  <!-- Donation Modal -->
  <div class="modal-overlay" id="donationModal" onclick="closeModalOutside(event)">
      <div class="modal-content">
          <button class="modal-close" onclick="closeDonationModal()"><i class="fa-solid fa-xmark"></i></button>

          <h2 style="color: white; font-size: 24px; margin-bottom: 24px;"><i class="fa-solid fa-heart" style="color:#ef4444;margin-right:8px;"></i>Make a Donation</h2>
          <form action="/donate" method="POST" enctype="multipart/form-data" id="donationForm">
              <!-- Hidden field for Paystack reference -->
              <input type="hidden" name="paystack_reference" id="paystack_reference" value="">
              <input type="hidden" name="currency" value="NGN">

              <div class="type-toggle">
                  <input type="radio" id="type-cash" name="donation_type" value="Cash" checked onchange="toggleFields()">
                  <label for="type-cash"><i class="fa-solid fa-money-bill-wave" style="margin-right:4px;"></i>Monetary</label>

                  <input type="radio" id="type-items" name="donation_type" value="Items" onchange="toggleFields()">
                  <label for="type-items"><i class="fa-solid fa-box-open" style="margin-right:4px;"></i>Physical Items</label>
              </div>

              <div class="form-row">
                  <div class="form-group">
                      <label>Full Name <span style="color:#f87171">*</span></label>
                      <input type="text" name="donor_name" id="donor_name" required placeholder="John Doe">
                  </div>
                  <div class="form-group">
                      <label>Email Address <span style="color:#f87171">*</span></label>
                      <input type="email" name="donor_email" id="donor_email" required placeholder="john@example.com">
                  </div>
              </div>

              <!-- Cash / Paystack Fields -->
              <div id="cash-fields">
                  <div class="form-group">
                      <label>Amount (₦ NGN) <span style="color:#f87171">*</span></label>
                      <input type="number" name="amount" id="amount" step="1" min="100" placeholder="e.g. 5000" required>
                      <small style="color:#64748b;font-size:12px;margin-top:4px;display:block;">Minimum: ₦100. Payment is secured by Paystack.</small>
                  </div>

                  <!-- Paystack Pay Button -->
                  <button type="button" id="pay-with-paystack-btn" onclick="initiatePaystack()"
                    style="width:100%;padding:14px;background:#0ba4db;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;margin-bottom:12px;display:flex;align-items:center;justify-content:center;gap:10px;transition:background 0.2s;">
                    <img src="https://checkout.paystack.com/assets/img/logos/paystack-logo-white.svg" alt="Paystack" style="height:22px;"> Pay Securely with Paystack
                  </button>

                  <!-- Paystack success info (shown after payment) -->
                  <div id="paystack-success-info" style="display:none;padding:12px 16px;background:#064e3b;border:1px solid #059669;border-radius:8px;color:#6ee7b7;font-size:13px;margin-bottom:12px;">
                    <i class="fa-solid fa-circle-check"></i> Payment verified! Click <strong>Complete Donation</strong> below to save your record.
                  </div>

                  <!-- Fallback submit for after paystack -->
                  <button type="submit" id="complete-donation-btn" style="display:none;width:100%;padding:14px;background:#4f46e5;color:#fff;border:none;border-radius:8px;font-size:16px;font-weight:600;cursor:pointer;">
                    <i class="fa-solid fa-paper-plane"></i> Complete Donation
                  </button>
              </div>

              <!-- Item Fields -->
              <div id="item-fields" class="form-group" style="display: none;">
                  <label>Item Description / Quantity <span style="color:#f87171">*</span></label>
                  <textarea name="item_description" id="item_description" rows="3" placeholder="E.g., 20 boxes of clothes, 5 crates of milk..."></textarea>
                  <label style="margin-top: 12px;">Item Image (Optional)</label>
                  <input type="file" name="item_image" accept="image/*" capture="environment">
                  <button type="submit" class="submit-btn" style="width:100%;margin-top:16px;">
                    <i class="fa-solid fa-paper-plane"></i> Submit Item Donation
                  </button>
              </div>
          </form>
      </div>
  </div>

  <script>
      // ── Paystack Key (injected server-side) ──
      var PAYSTACK_KEY = '<%= paystackKey %>';

      // ── Modal logic ──
      function openDonationModal() {
          document.getElementById('donationModal').classList.add('active');
          document.body.style.overflow = 'hidden';
      }

      function closeDonationModal() {
          document.getElementById('donationModal').classList.remove('active');
          document.body.style.overflow = 'auto';
      }

      function closeModalOutside(event) {
          if (event.target === document.getElementById('donationModal')) {
              closeDonationModal();
          }
      }

      // ── Toggle Cash / Items ──
      function toggleFields() {
          const isCash = document.getElementById('type-cash').checked;
          document.getElementById('cash-fields').style.display = isCash ? 'block' : 'none';
          document.getElementById('item-fields').style.display = isCash ? 'none' : 'block';
          const amount = document.getElementById('amount');
          const desc = document.getElementById('item_description');
          if (isCash) {
              amount.setAttribute('required', 'true');
              desc.removeAttribute('required');
          } else {
              amount.removeAttribute('required');
              desc.setAttribute('required', 'true');
              // Reset paystack state when switching to items
              document.getElementById('paystack_reference').value = '';
              document.getElementById('paystack-success-info').style.display = 'none';
              document.getElementById('pay-with-paystack-btn').style.display = 'flex';
              document.getElementById('complete-donation-btn').style.display = 'none';
          }
      }

      // ── Initiate Paystack payment ──
      function initiatePaystack() {
          if (!PAYSTACK_KEY) {
              alert('Online payment is not configured yet. Please contact us directly.');
              return;
          }
          const name = document.getElementById('donor_name').value.trim();
          const email = document.getElementById('donor_email').value.trim();
          const amountVal = parseFloat(document.getElementById('amount').value);

          if (!name) { alert('Please enter your full name.'); return; }
          if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { alert('Please enter a valid email address.'); return; }
          if (!amountVal || amountVal < 100) { alert('Please enter an amount of at least ₦100.'); return; }

          var handler = PaystackPop.setup({
              key: PAYSTACK_KEY,
              email: email,
              amount: Math.round(amountVal * 100), // Paystack expects kobo
              currency: 'NGN',
              ref: 'OMS-' + Date.now() + '-' + Math.floor(Math.random() * 1e6),
              metadata: { donor_name: name },
              callback: function(response) {
                  // Payment successful — store reference and show submit button
                  document.getElementById('paystack_reference').value = response.reference;
                  document.getElementById('paystack-success-info').style.display = 'block';
                  document.getElementById('pay-with-paystack-btn').style.display = 'none';
                  document.getElementById('complete-donation-btn').style.display = 'block';
              },
              onClose: function() {
                  // User closed Paystack popup without paying — do nothing
              }
          });
          handler.openIframe();
      }

      // ── Server-side messages ──
      <% if (typeof error !== 'undefined' && error) { %>
          Swal.fire({
              icon: 'error',
              title: 'Submission Error',
              text: '<%- error %>',
              background: '#1E293B',
              color: '#fff',
              confirmButtonColor: '#EF4444'
          }).then(() => { openDonationModal(); });
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
          Swal.fire({
              icon: 'success',
              title: 'Thank You!',
              text: 'Your generous donation has been successfully recorded. A confirmation email has been sent to you.',
              background: '#1E293B',
              color: '#fff',
              confirmButtonColor: '#10b981'
          });
      <% } %>

      // Initial setup
      toggleFields();
  </script>
</body>
</html>
