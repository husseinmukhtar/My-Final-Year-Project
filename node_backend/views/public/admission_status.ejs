<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Adoption Application Status</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .container { max-width: 760px; margin: 4rem auto; padding: 1.5rem; }
        .card { background: rgba(15, 23, 42, 0.9); border: 1px solid rgba(99, 102, 241, 0.25); border-radius: 14px; padding: 1.5rem; color: #fff; }
        .form-row { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 1rem; }
        .form-group { flex: 1; min-width: 240px; }
        .form-control { width: 100%; padding: 0.7rem 0.9rem; border-radius: 8px; border: 1px solid rgba(148, 163, 184, 0.35); background: rgba(15, 23, 42, 0.6); color: #fff; }
        .status { display: inline-block; margin-top: 0.4rem; padding: 0.25rem 0.7rem; border-radius: 999px; font-size: 0.85rem; background: rgba(99, 102, 241, 0.2); border: 1px solid rgba(99, 102, 241, 0.5); }
        .muted { color: #94a3b8; font-size: 0.9rem; }
        .error { background: rgba(239, 68, 68, 0.2); color: #fecaca; padding: 0.8rem; border-radius: 8px; margin-bottom: 1rem; }
    </style>
</head>
<body class="bg-gray-900">
    <div class="container">
        <div class="card">
            <h2 style="margin-top: 0;">Check Adoption Application Status</h2>
            <p class="muted">Enter your application ID and email address used during application.</p>
            <% if (error) { %><div class="error"><%= error %></div><% } %>
            <form method="POST" action="/admission/status">
                <div class="form-row">
                    <div class="form-group">
                        <label>Application ID</label>
                        <input class="form-control" type="number" name="id" min="1" required value="<%= query.id || '' %>">
                    </div>
                    <div class="form-group">
                        <label>Email</label>
                        <input class="form-control" type="email" name="email" required value="<%= query.email || '' %>">
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="fa-solid fa-magnifying-glass"></i> Check status</button>
            </form>

            <% if (application) { %>
                <hr style="border-color: rgba(148,163,184,0.25); margin: 1.3rem 0;">
                <p><strong>Applicant:</strong> <%= application.adopter_full_name %></p>
                <p><strong>Current status:</strong> <span class="status"><%= application.adoption_status %></span></p>
                <p><strong>Application date:</strong> <%= application.application_date ? String(application.application_date).slice(0,10) : '—' %></p>
                <p><strong>Child:</strong> <%= application.child_display_name || '—' %></p>
                <p><strong>Assigned staff:</strong> <%= application.assigned_staff || '—' %></p>
                <p><strong>Visit/interview appointment:</strong>
                    <% if (application.visit_scheduled_at) { %>
                        <strong><%= String(application.visit_scheduled_at).replace('T', ' ').slice(0, 16) %></strong>
                    <% } else { %>
                        Not scheduled yet.
                    <% } %>
                </p>
            <% } else if (searched) { %>
                <p class="muted" style="margin-top: 1rem;">No record matched those details.</p>
            <% } %>
        </div>
    </div>
</body>
</html>
