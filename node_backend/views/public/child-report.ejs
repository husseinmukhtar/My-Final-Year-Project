<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Report / Register a Child</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-light">
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">OMS</a>
            <a class="btn btn-outline-light btn-sm" href="/">Home</a>
        </div>
    </nav>

    <main class="container py-5">
        <div class="text-center mb-4">
            <h1 class="fw-bold">Report / Register a Child</h1>
            <p class="text-muted mb-0">Choose the option that matches your request.</p>
        </div>

        <div class="row g-4 justify-content-center">
            <div class="col-12 col-md-6 col-lg-5">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body p-4 text-center">
                        <div class="display-5 text-danger mb-3"><i class="fa-solid fa-location-dot"></i></div>
                        <h2 class="h4">Report Abandoned Child</h2>
                        <p class="text-muted">Send location, basic child details, description, and a photo for review.</p>
                        <a class="btn btn-danger w-100" href="/public/report-child">Open report form</a>
                    </div>
                </div>
            </div>
            <div class="col-12 col-md-6 col-lg-5">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body p-4 text-center">
                        <div class="display-5 text-primary mb-3"><i class="fa-solid fa-file-circle-plus"></i></div>
                        <h2 class="h4">Request Child Admission</h2>
                        <p class="text-muted">Submit an admission request with guardian and child information.</p>
                        <a class="btn btn-primary w-100" href="/public/admission">Open admission form</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</body>
</html>
