<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        body { background: #0f172a; color: #f8fafc; }
        .module-card { background: transparent; transition: transform 0.2s ease, box-shadow 0.2s ease; border: 1px solid rgba(99, 102, 241, 0.25); }
        .module-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(15, 23, 42, 0.45); }
        .module-card .card-body { background: rgba(30, 41, 59, 0.85); backdrop-filter: blur(12px); border-radius: 0.5rem; }
        .module-card a { text-decoration: none; color: #f8fafc; font-weight: 600; }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Welcome, <%= user.full_name %> (Administrator)</h2>
                <p class="text-light-emphasis mb-0">Administrative control panel</p>
            </div>
            <a href="/logout" class="btn btn-outline-light">Logout</a>
        </div>

        <% if (typeof stats !== 'undefined' && stats) { %>
        <div class="row g-4 mb-5">
            <div class="col-md-3">
                <div class="card module-card h-100" style="border-left: 4px solid #6366f1;">
                    <div class="card-body">
                        <h6 class="text-uppercase mb-2" style="color: #94a3b8; font-size: 0.75rem; letter-spacing: 0.5px;">Total Children</h6>
                        <h3 class="mb-0 text-light"><%= stats.childrenCount || 0 %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card module-card h-100" style="border-left: 4px solid #818cf8;">
                    <div class="card-body">
                        <h6 class="text-uppercase mb-2" style="color: #94a3b8; font-size: 0.75rem; letter-spacing: 0.5px;">Active Staff</h6>
                        <h3 class="mb-0 text-light"><%= stats.staffCount || 0 %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card module-card h-100" style="border-left: 4px solid #facc15;">
                    <div class="card-body">
                        <h6 class="text-uppercase mb-2" style="color: #94a3b8; font-size: 0.75rem; letter-spacing: 0.5px;">Total Donations</h6>
                        <h3 class="mb-0 text-light"><%= stats.donationsCount || 0 %></h3>
                    </div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="card module-card h-100" style="border-left: 4px solid #34d399;">
                    <div class="card-body">
                        <h6 class="text-uppercase mb-2" style="color: #94a3b8; font-size: 0.75rem; letter-spacing: 0.5px;">Adoption Records</h6>
                        <h3 class="mb-0 text-light"><%= stats.adoptionCount || 0 %></h3>
                    </div>
                </div>
            </div>
        </div>
        <% } %>

        <h4 class="mb-3 text-light">Quick Links</h4>

        <div class="row g-4">
            <div class="col-md-6 col-lg-4"><div class="card module-card h-100"><div class="card-body"><a href="/children" class="stretched-link">Child Records</a></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card module-card h-100"><div class="card-body"><a href="/staff" class="stretched-link">Staff Management</a></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card module-card h-100"><div class="card-body"><a href="/donations" class="stretched-link">Donation Management</a></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card module-card h-100"><div class="card-body"><a href="/adoptions" class="stretched-link">Adoption Requests</a></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card module-card h-100"><div class="card-body"><a href="/admin/admissions" class="stretched-link">Public Admissions</a></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card module-card h-100"><div class="card-body"><a href="/admin/reports" class="stretched-link">Abandoned Child Reports</a></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card module-card h-100"><div class="card-body"><a href="/reports" class="stretched-link">Report Generation</a></div></div></div>
            <div class="col-md-6 col-lg-4"><div class="card module-card h-100"><div class="card-body"><a href="/register" class="stretched-link">Register New User</a></div></div></div>
        </div>
    </div>
</body>
</html>
