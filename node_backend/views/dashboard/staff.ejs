<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Staff Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/dashboard.css">
    <style>
        body { background: #0f172a; color: #f8fafc; }
        .module-card { transition: transform 0.2s ease, box-shadow 0.2s ease; border: 1px solid rgba(99, 102, 241, 0.25); }
        .module-card:hover { transform: translateY(-4px); box-shadow: 0 10px 24px rgba(15, 23, 42, 0.45); }
        .module-card .card-body { background: rgba(15, 23, 42, 0.75); border-radius: 0.5rem; }
        .module-card a { text-decoration: none; color: #f8fafc; font-weight: 600; }
        .module-card p { margin: 0.35rem 0 0; color: #cbd5e1; font-size: 0.9rem; }
    </style>
</head>
<body>
    <div class="container py-5">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h2 class="mb-1">Welcome, <%= user.full_name %> (Staff)</h2>
                <p class="text-light-emphasis mb-0">Operational dashboard</p>
            </div>
            <a href="/logout" class="btn btn-outline-light">Logout</a>
        </div>

        <div class="row g-4">
            <div class="col-md-6">
                <div class="card module-card h-100">
                    <div class="card-body">
                        <a href="/children" class="stretched-link">Child Records</a>
                        <p>View and Search only</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card module-card h-100">
                    <div class="card-body">
                        <a href="/adoptions" class="stretched-link">Adoption Requests</a>
                        <p>View assigned visits and complete them</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card module-card h-100">
                    <div class="card-body">
                        <a href="/donations" class="stretched-link">Donation Records</a>
                        <p>View only</p>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="card module-card h-100">
                    <div class="card-body">
                        <a href="/reports" class="stretched-link">Report Generation</a>
                        <p>View only</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
