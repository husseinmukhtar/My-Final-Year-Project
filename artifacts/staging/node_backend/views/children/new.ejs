<%- include('../partials/header', { pageTitle: 'Add New Child', activePage: 'add' }) %>

<div class="page-title" style="margin-bottom: 24px;">
    Add New Child
</div>

<div class="card form-container">
    <form action="/children" method="POST" class="validate-form" novalidate>
        
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Full Name</label>
                <input type="text" name="name" class="form-control" required placeholder="John Doe">
                <span class="helper-text">Ensure full legal name is provided</span>
                <span class="invalid-feedback">Please enter the child's full name.</span>
            </div>
            
            <div class="form-group">
                <label class="form-label">Age</label>
                <input type="number" name="age" class="form-control" required min="0" max="18" placeholder="e.g. 5">
                <span class="helper-text">Must be between 0 and 18 years</span>
                <span class="invalid-feedback">Please provide a valid age between 0 and 18.</span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Gender</label>
                <select name="gender" class="form-control" required>
                    <option value="" disabled selected>Select Gender</option>
                    <option value="Male">Male</option>
                    <option value="Female">Female</option>
                    <option value="Other">Other</option>
                </select>
                <span class="invalid-feedback">Please select a gender.</span>
            </div>
            
            <div class="form-group">
                <label class="form-label">Status</label>
                <select name="status" class="form-control" required>
                    <option value="" disabled selected>System Status</option>
                    <option value="Available">Available</option>
                    <option value="Adopted">Adopted</option>
                    <option value="Pending">Pending</option>
                    <option value="Processing">Processing</option>
                </select>
                <span class="invalid-feedback">Please select a status.</span>
            </div>
        </div>

        <div class="form-actions">
            <a href="/children" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-plus"></i> Add Child Record
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const forms = document.querySelectorAll('.validate-form');
        forms.forEach(form => {
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    });
</script>

<%- include('../partials/footer') %>
