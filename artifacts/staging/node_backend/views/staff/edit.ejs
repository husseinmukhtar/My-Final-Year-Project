<%- include('../partials/header', { pageTitle: 'Edit Staff Member', activePage: 'staff' }) %>

<div class="page-title" style="margin-bottom: 24px;">
    Edit Staff Member
</div>

<div class="card form-container">
    <form action="/staff/<%= staff.id %>" method="POST" class="validate-form" novalidate>
        
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Full Name</label>
                <input type="text" name="full_name" class="form-control" value="<%= staff.full_name %>" required placeholder="John Doe">
                <span class="invalid-feedback">Staff full name is required.</span>
            </div>
            
            <div class="form-group">
                <label class="form-label">Email Address</label>
                <input type="email" name="email" class="form-control" value="<%= staff.email %>" required placeholder="john@example.com">
                <span class="invalid-feedback">A valid and unique email address is required.</span>
            </div>
        </div>

        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Phone Number</label>
                <input type="text" name="phone" class="form-control" value="<%= staff.phone %>" required placeholder="+1 234 567 890">
                <span class="invalid-feedback">Phone number is required.</span>
            </div>

            <div class="form-group">
                <label class="form-label">Role</label>
                <input type="text" name="role" class="form-control" value="<%= staff.role %>" required placeholder="e.g. Caretaker, Nurse">
                <span class="invalid-feedback">Staff role is required.</span>
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Address</label>
            <textarea name="address" class="form-control" rows="3" placeholder="Full physical address"><%= staff.address %></textarea>
        </div>

        <div class="form-group">
            <label class="form-label">Date Joined</label>
            <% 
               let dateVal = '';
               if (staff.date_joined) {
                   const d = new Date(staff.date_joined);
                   if (!isNaN(d.valueOf())) {
                       const y = d.getFullYear();
                       const m = String(d.getMonth() + 1).padStart(2, '0');
                       const day = String(d.getDate()).padStart(2, '0');
                       dateVal = `${y}-${m}-${day}`;
                   } else {
                       dateVal = staff.date_joined;
                   }
               }
            %>
            <input type="date" name="date_joined" class="form-control" value="<%= dateVal %>" required>
            <span class="invalid-feedback">Start date is required.</span>
        </div>

        <div class="form-actions">
            <a href="/staff" class="btn btn-secondary">
                <i class="fa-solid fa-arrow-left"></i> Discard Changes
            </a>
            <button type="submit" class="btn btn-primary">
                <i class="fa-solid fa-check"></i> Update Staff
            </button>
        </div>
    </form>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function() {
        const forms = document.querySelectorAll('.validate-form');
        forms.forEach(form => {
            form.addEventListener('submit', function(event) {
                if (!form.checkValidity()) {
                    event.preventDefault();
                    event.stopPropagation();
                }
                form.classList.add('was-validated');
            }, false);
        });
    });
</script>

<%- include('../partials/footer') %>
