<div class="page-title" style="margin-bottom: 24px;">Donate</div>

<div id="donateAlert"></div>

<div class="card form-container">
    <form id="donateForm" enctype="multipart/form-data" novalidate>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Donor name</label>
                <input class="form-control" name="donor_name" required>
            </div>
            <div class="form-group">
                <label class="form-label">Email</label>
                <input class="form-control" type="email" name="donor_email" id="donor_email">
            </div>
        </div>
        <div class="form-row">
            <div class="form-group">
                <label class="form-label">Phone</label>
                <input class="form-control" name="phone" id="donor_phone">
            </div>
            <div class="form-group">
                <label class="form-label">Donation type</label>
                <select class="form-control" id="donation_type" name="donation_type" required>
                    <option value="Cash">Cash</option>
                    <option value="Items">Physical items</option>
                </select>
            </div>
        </div>

        <div id="cashFields">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Currency</label>
                    <select class="form-control" name="currency">
                        <option value="NGN">Naira (NGN)</option>
                        <option value="USD">Dollar (USD)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Amount</label>
                    <input class="form-control" type="number" step="0.01" min="1" name="amount">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Payment method</label>
                <select class="form-control" name="payment_method">
                    <option value="Bank Transfer">Bank Transfer</option>
                    <option value="Credit Card">Credit Card</option>
                </select>
            </div>
        </div>

        <div id="itemFields" style="display:none;">
            <div class="form-row">
                <div class="form-group">
                    <label class="form-label">Item name</label>
                    <input class="form-control" name="item_description" id="item_description" placeholder="Rice, clothes, school books">
                </div>
                <div class="form-group">
                    <label class="form-label">Quantity</label>
                    <input class="form-control" name="item_quantity" id="item_quantity" placeholder="e.g. 3 bags">
                </div>
            </div>
            <div class="form-group">
                <label class="form-label">Condition</label>
                <select class="form-control" name="item_condition" id="item_condition">
                    <option value="">Select condition</option>
                    <option value="New">New</option>
                    <option value="Good">Good</option>
                    <option value="Used">Used</option>
                </select>
            </div>
            <div class="form-group">
                <label class="form-label">Upload image or use camera</label>
                <input class="form-control" type="file" name="item_photo" accept="image/*" capture="environment">
            </div>
        </div>

        <div class="form-group">
            <label class="form-label">Message</label>
            <textarea class="form-control" name="message" rows="3"></textarea>
        </div>
        <button class="btn btn-success" type="submit"><i class="fa-solid fa-heart"></i> Submit donation</button>
    </form>
</div>

<script>
(function () {
    const form = document.getElementById('donateForm');
    const type = document.getElementById('donation_type');
    const email = document.getElementById('donor_email');
    const phone = document.getElementById('donor_phone');
    const cash = document.getElementById('cashFields');
    const item = document.getElementById('itemFields');
    const itemName = document.getElementById('item_description');
    const itemQty = document.getElementById('item_quantity');
    const itemCondition = document.getElementById('item_condition');
    const alertBox = document.getElementById('donateAlert');

    function toggle() {
        const isItems = type.value === 'Items';
        cash.style.display = isItems ? 'none' : '';
        item.style.display = isItems ? '' : 'none';
        email.required = !isItems;
        phone.required = isItems;
        itemName.required = isItems;
        itemQty.required = isItems;
        itemCondition.required = isItems;
    }
    type.addEventListener('change', toggle);
    toggle();

    form.addEventListener('submit', async function (event) {
        event.preventDefault();
        alertBox.innerHTML = '';
        const data = new FormData(form);
        const isItems = data.get('donation_type') === 'Items';
        if (!form.checkValidity()) {
            form.classList.add('was-validated');
            return;
        }
        const endpoint = isItems ? '/api/donations/items' : '/api/donations/initiate';
        const options = isItems
            ? { method: 'POST', body: data }
            : { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(Object.fromEntries(data.entries())) };
        const res = await fetch(endpoint, options);
        const json = await res.json();
        if (!json.success) {
            alertBox.innerHTML = '<div class="alert alert-danger">' + (json.message || 'Donation could not be submitted.') + '</div>';
            return;
        }
        if (!isItems && json.data && json.data.reference) {
            await fetch('/api/donations/process', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ reference: json.data.reference, simulatedStatus: 'awaiting' })
            });
        }
        form.reset();
        toggle();
        alertBox.innerHTML = '<div class="alert alert-success">Thank you. Your donation has been submitted.</div>';
    });
})();
</script>
